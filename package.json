{
  "name": "flow-frontend-checks",
  "private": true,
  "description": "Dev-verktyg för frontend-typkontroll (JSDoc + tsc --checkJs) och lint. Ingen build — appen serverar ren JS.",
  "scripts": {
    "typecheck": "tsc -p jsconfig.json --noEmit",
    "lint": "eslint app/frontend/js app/frontend/sw.js",
    "test:fast": "python -m pytest -m \"not browser\"",
    "test:browser": "python -m pytest -m browser --reruns 2 --reruns-delay 5"
  },
  "devDependencies": {
    "eslint": "^10.6.0",
    "openapi-typescript": "^7.13.0",
    "typescript": "^5.7.2"
  },
  "dependencies": {
    "rrweb": "^2.1.0"
  },
  "overrides": {
    "@redocly/openapi-core": {
      "minimatch": {
        "brace-expansion": "5.0.9"
      },
      "js-yaml": "^4.2.1"
    }
  }
}
