#!/bin/sh
# Kor hela testsviten innan push sa CI-fel fangas lokalt i fortid.
# Bakgrund: tva pushar 2026-07-03/04 blev roda i CI for att sviten inte
# kordes lokalt forst (saknad modul resp. kontraktstest for Verktyg-menyn).
#
# Hoppa over i nodfall med FLOW_SKIP_PREPUSH_TESTS=1 (dokumentera varfor i
# commit-/PR-texten). Anvand inte `git push --no-verify` slentrianmassigt.

# stdin listar refs som pushas; tomt = inget att pusha (t.ex. --tags utan nytt).
refs="$(cat)"
if [ -z "$refs" ]; then
    exit 0
fi

if [ "${FLOW_SKIP_PREPUSH_TESTS:-0}" = "1" ]; then
    echo "  ⚠ pre-push: FLOW_SKIP_PREPUSH_TESTS=1 – hoppar over testsviten." >&2
    exit 0
fi

echo "  pre-push: kor testsviten (avbryt med Ctrl+C; nodfall: FLOW_SKIP_PREPUSH_TESTS=1) ..." >&2

python -m pytest -x -q
status=$?
if [ $status -ne 0 ]; then
    echo "" >&2
    echo "  ✖ PRE-PUSH BLOCKERAD: testsviten faller. Fixa testerna fore push." >&2
    exit $status
fi

exit 0
