#!/bin/sh
# Kor hela testsviten innan push sa CI-fel fangas lokalt i fortid.
# Bakgrund: tva pushar 2026-07-03/04 blev roda i CI for att sviten inte
# kordes lokalt forst (saknad modul resp. kontraktstest for Verktyg-menyn).
#
# Hoppa over i nodfall med FLOW_SKIP_PREPUSH_TESTS=1 (dokumentera varfor i
# commit-/PR-texten). Anvand inte `git push --no-verify` slentrianmassigt.

# stdin listar refs som pushas; tomt = inget att pusha (t.ex. --tags utan nytt).
refs="$(cat)"
if [ -z "$refs" ]; then
    exit 0
fi

if [ "${FLOW_SKIP_PREPUSH_TESTS:-0}" = "1" ]; then
    echo "  ⚠ pre-push: FLOW_SKIP_PREPUSH_TESTS=1 – hoppar over testsviten." >&2
    exit 0
fi

# Dokument-endast-pushar (wiki/markdown) behover ingen testsvit. Kraver att
# ALLA pushade refs bara innehaller dokumentandringar; nya branchar utan
# kand bas kors alltid mot sviten.
docs_only=1
while read -r local_ref local_sha remote_ref remote_sha; do
    [ -z "$local_ref" ] && continue
    if [ "$local_sha" = "0000000000000000000000000000000000000000" ]; then
        continue  # ref-radering: inget att testa
    fi
    if [ "$remote_sha" = "0000000000000000000000000000000000000000" ]; then
        base="$(git merge-base origin/main "$local_sha" 2>/dev/null)"
        [ -z "$base" ] && { docs_only=0; break; }
    else
        base="$remote_sha"
    fi
    changed="$(git diff --name-only "$base" "$local_sha" 2>/dev/null)"
    [ -z "$changed" ] && continue
    non_docs="$(printf '%s\n' "$changed" | grep -vE '^wiki/|\.md$' | head -1)"
    if [ -n "$non_docs" ]; then
        docs_only=0
        break
    fi
done <<EOF
$refs
EOF

if [ "$docs_only" = "1" ]; then
    echo "  pre-push: endast dokumentandringar (wiki/markdown) – hoppar over testsviten." >&2
    exit 0
fi

echo "  pre-push: kor testsviten (avbryt med Ctrl+C; nodfall: FLOW_SKIP_PREPUSH_TESTS=1) ..." >&2

# Frontend-kontrakt: typkontroll (JSDoc + tsc) och ESLint. Snabba, kors fore
# pytest. Kraver Node + node_modules; varna och hoppa over annars sa pushar
# fran maskiner utan Node inte blockeras (CI tar dem da).
if command -v npx >/dev/null 2>&1 && [ -d node_modules ]; then
    npx tsc -p jsconfig.json --noEmit
    ts_status=$?
    if [ $ts_status -ne 0 ]; then
        echo "" >&2
        echo "  ✖ PRE-PUSH BLOCKERAD: frontend-typkontrollen faller (npm run typecheck)." >&2
        exit $ts_status
    fi
    npx eslint app/frontend/js
    lint_status=$?
    if [ $lint_status -ne 0 ]; then
        echo "" >&2
        echo "  ✖ PRE-PUSH BLOCKERAD: ESLint faller (npm run lint)." >&2
        exit $lint_status
    fi
else
    echo "  ⚠ pre-push: Node/node_modules saknas - hoppar over frontend-typkontroll och lint (kor npm install)." >&2
fi

# Browsertesterna (Playwright, -m browser) kors INTE har: de ar lastkansliga
# pa utvecklarmaskinen (OneDrive-synk, CPU-konkurrens gav falska rod 2026-07-06)
# och CI ar deras gate. Kor dem lokalt vid behov: python -m pytest -m browser
python -m pytest -x -q -m "not browser"
status=$?
if [ $status -ne 0 ]; then
    echo "" >&2
    echo "  ✖ PRE-PUSH BLOCKERAD: testsviten faller. Fixa testerna fore push." >&2
    exit $status
fi

exit 0
