DATABASE_URL=postgresql+psycopg://postgres:postgres@localhost:5432/flow
SECRET_KEY=dev-only-change-me-use-secrets-token-hex-32-in-production
ENVIRONMENT=development
MINIMAX_API_KEY=
MINIMAX_API_URL=https://api.minimax.io/v1/chat/completions
MINIMAX_MODEL=MiniMax-M2.7
MINIMAX_MAX_TOKENS=700
MINIMAX_TIMEOUT_SECONDS=30
TRACKING_ALLOW_VALUE_SAMPLES=false
GEMINI_API_KEY=
GEMINI_MODEL=gemini-2.5-pro
GEMINI_API_BASE_URL=https://generativelanguage.googleapis.com
META_ANALYSIS_TIMEOUT_SECONDS=120
META_ANALYSIS_AUTO_START=true
META_ANALYSIS_MAX_VIDEO_BYTES=268435456
# Meta uploads have no login/business_id, so the Dispatchpallar ASK lookup can't
# resolve a tenant on its own when DATA_SOURCE_API_BASE_URL uses {tenant}.
META_ANALYSIS_DATA_SOURCE_TENANT=frey
# Supports {tenant}, for example https://data-{tenant}.example.test
DATA_SOURCE_API_BASE_URL=
# Alternativa bas-URL:er – bara för ASK-diagnostiken (Arkivstatus, superuser)
DATA_SOURCE_API_BASE_URL2=
DATA_SOURCE_API_BASE_URL3=
DATA_SOURCE_API_KEY=
DATA_SOURCE_API_CLIENT=
DATA_SOURCE_API_KEY_HEADER=
DATA_SOURCE_API_CLIENT_HEADER=
DATA_SOURCE_VIEW_DATA_PATH_TEMPLATE=
# Kill-switch för alla externa ASK-hämtningar. Sätt till "false" för att stänga
# av arkiv-cache-seed, live-vyer och diagnostikproben helt. Tomt/"true" = på.
DATA_SOURCE_API_FETCH_ENABLED=
DATA_SOURCE_TIMEOUT_SECONDS=30
DATA_SOURCE_VERIFY_SSL=true
DATA_SOURCE_CA_BUNDLE=
DATA_SOURCE_MAX_ROWS=1000
DATA_SOURCE_CATALOG_PATH=
DATA_SOURCE_CATALOG_JSON=
# Lokal arkiv-cache (DuckDB, per tenant). Endast lokal dev – speglar dblog_*-arkiv
# så Sankey/Produktivitet/Hämta data läser historik lokalt istället för via API.
# Sätt =1 lokalt för att slå på. Startar aldrig i produktion. Se wiki/local-archive-cache.md.
ARCHIVE_CACHE_ENABLED=
ARCHIVE_CACHE_DIR=
ARCHIVE_CACHE_SEED_DAYS=400
ARCHIVE_CACHE_CHUNK_DAYS=14
ARCHIVE_CACHE_EMPTY_STOP_DAYS=300
# Djup-seeden (hela dblog-historiken) körs via CLI, inte vid serverstart:
#   python -m app.backend.archive_cache_cli
# Servern toppar bara på redan seedade vyer. Sätt =1 om servern ändå ska seeda vid start.
ARCHIVE_CACHE_SEED_ON_START=
ARCHIVE_CACHE_SEED_WORKERS=5
ARCHIVE_CACHE_SYNC_HOUR=0
ARCHIVE_CACHE_SYNC_MINUTE=1
HEALTHCHECK_PUBLIC_URL=
